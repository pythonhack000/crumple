{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "crowd-hunch",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Crumple: open today's level",
        "description": "Close yesterday and open today's level now",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/start-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "scheduler": {
    "tasks": {
      "new-day": {
        "endpoint": "/internal/scheduler/new-day",
        "cron": "0 0 * * *"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "dev": {
    "subreddit": "crowd_hunch_dev"
  }
}
